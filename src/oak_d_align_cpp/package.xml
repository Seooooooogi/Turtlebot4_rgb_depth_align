<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oak_d_align_cpp</name>
  <version>0.1.0</version>
  <description>OAK-D RGB/Depth alignment node (C++ port of oak_d_align) for TurtleBot4</description>
  <maintainer email="todo@example.com">rokey</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>
  <depend>depthai</depend>
  <depend>depthai_bridge</depend>

  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>

  <!-- turtlebot4_bringup.launch.py runtime dependencies -->
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>turtlebot4_bringup</exec_depend>
  <exec_depend>turtlebot4_description</exec_depend>
  <exec_depend>turtlebot4_diagnostics</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
